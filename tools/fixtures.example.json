      "expected_prepass_rgbi16_raw_byte_sha256": "4a99fe2f2b5965aced86beec1c7e38ff731945458452d895cfa3581c29da7636",
      "expected_logical_output_sha256": "f2e9b84ddc6bc49e2e34b9dd86cac992ba12add6e0f4a14720e2fde74719958a",
